# ============================================================
# DATABASE_URL
# ============================================================
# Default works as-is if you're using the provided docker-compose.yml
# (`docker compose up -d db`). No account needed.
DATABASE_URL=postgresql+asyncpg://sera:sera@localhost:5432/sera

# ============================================================
# TELEGRAM_BOT_TOKEN
# ============================================================
# 1. Open Telegram, search for "@BotFather" and start a chat.
# 2. Send: /newbot
# 3. Give it a display name (e.g. "Sera Assistant").
# 4. Give it a username ending in "bot" (e.g. "sera_rag_bot").
# 5. BotFather replies with a token like: 123456789:AAH...
TELEGRAM_BOT_TOKEN=

# ============================================================
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
# ============================================================
# 1. Go to https://console.cloud.google.com/ and create (or pick) a project.
# 2. Left menu -> "APIs & Services" -> "Library" -> search "Google Drive API"
#    -> Enable. The first slice requests Google identity plus read-only Drive.
# 3. Left menu -> "APIs & Services" -> "OAuth consent screen":
#    - User type: External (unless you have a Workspace org).
#    - Fill app name / support email, add your own Google account as a
#      "Test user" (required while the app is in Testing mode).
# 4. Left menu -> "APIs & Services" -> "Credentials" -> "+ Create Credentials"
#    -> "OAuth client ID":
#    - Application type: Web application.
#    - Authorized redirect URIs: add the value you'll put in
#      GOOGLE_OAUTH_REDIRECT_URI below (your ngrok URL + /oauth/google/callback).
#    - Create -> copy the "Client ID" and "Client Secret" shown.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Maps uses a separate restricted API key; it is not Google OAuth.
GOOGLE_MAPS_API_KEY=

# Google Drive, Gmail, Calendar, and Meet use the Google OAuth client above.
# Enable the APIs and declare only the scopes used by each connector.

# ============================================================
# GOOGLE_OAUTH_REDIRECT_URI
# ============================================================
# Google OAuth requires a public HTTPS callback URL, even in local dev.
# 1. Install ngrok: https://ngrok.com/download (free account is enough).
# 2. Run the backend locally first (uvicorn app.main:app --reload), it
#    listens on port 8000.
# 3. In another terminal: ngrok http 8000
# 4. ngrok prints a URL like: https://a1b2-c3d4.ngrok-free.app
# 5. Set this variable to that URL + /oauth/google/callback, e.g.:
#    https://a1b2-c3d4.ngrok-free.app/oauth/google/callback
# 6. Paste that SAME full URL into the Google Cloud Console redirect URIs
#    field from the step above — they must match exactly.
# Note: the free ngrok URL changes every time you restart ngrok, so you'll
# need to update both this value and the Google Console entry each time.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/google/callback

# ============================================================
# SLACK OAuth
# ============================================================
# Create an app at https://api.slack.com/apps, add the exact redirect URI,
# and configure least-privilege bot/user scopes in OAuth & Permissions.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/slack/callback

# ============================================================
# MICROSOFT / TEAMS OAuth
# ============================================================
# Register an app at https://entra.microsoft.com/ and add the exact redirect URI.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/microsoft/callback

# ============================================================
# GEMINI_API_KEY / GEMINI_MODEL / GEMINI_EMBED_MODEL
# ============================================================
# 1. Go to https://aistudio.google.com/apikey
# 2. Sign in with a Google account -> "Create API key" -> copy it.
# Free tier is enough for MVP testing (rate-limited, not unlimited).
# Used for both answer generation and embeddings (no local Ollama needed).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# ============================================================
# TOKEN_ENCRYPTION_KEY
# ============================================================
# Not an external account — generate it yourself, once, with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Used to encrypt stored Google OAuth tokens at rest. Keep it secret;
# losing it means every connected Google Drive account needs to
# re-authenticate.
TOKEN_ENCRYPTION_KEY=

# ============================================================
# Tuning (no account needed, safe to leave at defaults)
# ============================================================
DRIVE_SYNC_INTERVAL_MINUTES=15
MEETING_SYNC_MAX_RECORDS=100
NOTES_SYNC_MAX_RECORDS=100
RAG_MIN_SIMILARITY=0.55
RAG_TOP_K=5
